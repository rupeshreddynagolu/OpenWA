# OpenWA on cPanel — copy to `.env` in the application root and fill in the CHANGE_ME values.
# Values set in cPanel's "Environment variables" panel take precedence over this file.

# --- Runtime --------------------------------------------------------------------------------------
NODE_ENV=production
# Passenger hands the server its own socket; the port below is only used when you run `node app.js` by hand.
PORT=2785
# Shared hosting cannot run headless Chromium: Baileys is the only engine that works here.
ENGINE_TYPE=baileys
# Reconnect linked WhatsApp sessions whenever Passenger (re)starts the app.
AUTO_START_SESSIONS=true

# --- Data database: MariaDB from cPanel > MySQL Databases ------------------------------------------
# cPanel prefixes database and user names with your account name, e.g. myacct_openwa.
DATABASE_TYPE=mariadb
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=CHANGE_ME_cpaneluser_openwa
DATABASE_USERNAME=CHANGE_ME_cpaneluser_openwa
DATABASE_PASSWORD=CHANGE_ME_strong_password
DATABASE_SYNCHRONIZE=false

# --- Durable queue without Redis: Sidequest stores jobs in the same MariaDB database ---------------
QUEUE_ENABLED=true
QUEUE_DRIVER=sidequest
REDIS_ENABLED=false
CACHE_ENABLED=false

# --- Behind cPanel's Apache + Passenger --------------------------------------------------------------
# Apache forwards requests from this machine; trust it to pass the real client IP (rate limits, audit).
TRUSTED_PROXIES=127.0.0.1,::1
# The dashboard origin, e.g. https://openwa.example.com
CORS_ORIGINS=https://CHANGE_ME.example.com

# --- Storage (local files under data/) ----------------------------------------------------------------
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/media

# --- Optional -------------------------------------------------------------------------------------------
# Public API docs at /api/docs (off by default in production).
# ENABLE_SWAGGER=true
# Pin the first admin key instead of letting the first boot generate one (32+ characters).
# API_MASTER_KEY=
LOG_LEVEL=info
